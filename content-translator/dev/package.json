{
  "name": "content-translator-dev",
  "description": "Dev app for the content-translator plugin.",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"${NODE_OPTIONS} --no-deprecation\" next dev --webpack",
    "dev:turbo": "pnpm dev --turbo",
    "dev:safe": "rm -rf .next && pnpm dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "format": "prettier --write src",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=./src/payload.config.ts payload",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=./src/payload.config.ts payload generate:types",
    "generate:schema": "payload-graphql generate:schema",
    "generate:importmap": "cross-env PAYLOAD_CONFIG_PATH=./src/payload.config.ts payload generate:importmap",
    "seed": "cross-env PAYLOAD_CONFIG_PATH=./src/payload.config.ts tsx seed-db.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.57",
    "@jhb.software/payload-content-translator-plugin": "workspace:*",
    "@jhb.software/payload-pages-plugin": "workspace:*",
    "@payloadcms/db-mongodb": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/translations": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "ai": "^7.0.91",
    "next": "16.3.4",
    "openai": "^7.9.0",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.8.0"
}
